# Copy to .env and fill in. These VITE_ values are embedded in the client bundle
# and are safe to expose (the Supabase anon key is protected by RLS). Do NOT put
# service-role keys or any server secret here — those belong in Supabase Edge
# Function secrets (Deno.env), never in a VITE_ variable.
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
